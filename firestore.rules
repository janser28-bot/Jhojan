rules_version = '2';

// ============================================================
// Reglas de seguridad — Agenda Serrano
// Pega este contenido en Firebase Console → Firestore Database
// → pestaña "Reglas" → Publicar
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Tareas: compartidas entre todos los usuarios autenticados.
    // Cualquiera del equipo puede leer y escribir cualquier tarea.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Perfiles: cualquier usuario autenticado puede leer todos los
    // perfiles (para mostrar nombre/avatar en las tareas), pero
    // cada quien solo puede escribir el suyo propio.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
